# AWS Credentials
# Copy this file to .env and fill in your actual AWS credentials
# DO NOT commit the .env file to version control

# Your AWS Access Key ID
export AWS_ACCESS_KEY_ID="your_access_key_here"

# Your AWS Secret Access Key
export AWS_SECRET_ACCESS_KEY="your_secret_key_here"

# AWS Region (default: us-east-1)
export AWS_REGION="us-east-1"

# Optional: AWS Session Token (only needed for temporary credentials)
# export AWS_SESSION_TOKEN="your_session_token_here"

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. Load the environment: source .env
# 4. Run Terraform commands: terraform init, terraform plan, terraform apply
